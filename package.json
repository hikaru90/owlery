{
	"name": "owlery",
	"private": true,
	"version": "0.2.0",
	"description": "Self-hosted email infrastructure for transactional and marketing email via Amazon SES",
	"type": "module",
	"license": "MIT",
	"homepage": "https://github.com/hikaru90/owlery#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hikaru90/owlery.git"
	},
	"bugs": {
		"url": "https://github.com/hikaru90/owlery/issues"
	},
	"keywords": [
		"email",
		"ses",
		"amazon-ses",
		"transactional-email",
		"marketing-email",
		"self-hosted",
		"sveltekit",
		"sqlite"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/build-worker.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev:worker": "tsx watch src/server/worker.ts",
		"dev:all": "concurrently -n app,worker -c blue,green \"npm run dev\" \"npm run dev:worker\"",
		"worker": "tsx src/server/worker.ts",
		"worker:prod": "node build/worker.js",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/lib/server/db/migrate.ts",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx src/lib/server/service/dev-seed.ts",
		"db:pull": "node scripts/pull-db.mjs",
		"db:export-parts": "tsx scripts/export-parts.ts",
		"db:import-parts": "tsx scripts/import-parts.ts",
		"start": "node scripts/supervisor.mjs",
		"start:web": "node build",
		"mcp": "tsx mcp/server.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/dompurify": "^3.2.0",
		"@types/nodemailer": "^8.0.1",
		"@vitest/coverage-v8": "^4.1.10",
		"concurrently": "^10.0.4",
		"drizzle-kit": "^0.31.10",
		"esbuild": "^0.28.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"resolve": "^1.22.12",
		"svelte": "^5.56.1",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.1",
		"typescript": "~6.0.3",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@aws-sdk/client-sesv2": "^3.1115.0",
		"@aws-sdk/client-sns": "^3.1115.0",
		"@aws-sdk/client-sts": "^3.1115.0",
		"@earendil-works/pi-coding-agent": "^0.84.2",
		"@lucide/svelte": "^1.33.0",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@xyflow/svelte": "^1.6.3",
		"arctic": "^3.7.0",
		"better-sqlite3": "^13.0.2",
		"bits-ui": "^2.19.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"isomorphic-dompurify": "^3.20.0",
		"juice": "^12.1.1",
		"linkedom": "^0.18.13",
		"marked": "^18.0.10",
		"mjml": "^5.4.0",
		"mode-watcher": "^1.1.0",
		"nanoid": "^6.0.0",
		"nodemailer": "^9.0.5",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"tldts": "^7.4.10",
		"zod": "^4.4.3"
	}
}
